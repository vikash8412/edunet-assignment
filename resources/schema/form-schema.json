{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://formbuilder.local/schema/form-schema.json",
    "title": "Form definition",
    "type": "object",
    "required": ["title", "sections"],
    "additionalProperties": false,
    "properties": {
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
        },
        "description": {
            "type": ["string", "null"],
            "maxLength": 2000
        },
        "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "multi_step": { "type": "boolean", "default": false },
                "success_message": { "type": ["string", "null"], "maxLength": 1000 },
                "submit_label": { "type": ["string", "null"], "maxLength": 60 },
                "max_per_day": { "type": ["integer", "null"], "minimum": 1 }
            }
        },
        "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "$ref": "#/$defs/section" }
        }
    },
    "$defs": {
        "section": {
            "type": "object",
            "required": ["id", "title", "fields"],
            "additionalProperties": false,
            "properties": {
                "id": { "$ref": "#/$defs/elementId" },
                "title": { "type": "string", "maxLength": 200 },
                "description": { "type": ["string", "null"], "maxLength": 2000 },
                "fields": {
                    "type": "array",
                    "maxItems": 100,
                    "items": { "$ref": "#/$defs/field" }
                }
            }
        },
        "field": {
            "type": "object",
            "required": ["id", "type", "key", "label"],
            "additionalProperties": false,
            "properties": {
                "id": { "$ref": "#/$defs/elementId" },
                "type": {
                    "enum": [
                        "text", "textarea", "number", "email", "phone", "date",
                        "dropdown", "radio", "checkbox", "file", "rating",
                        "hidden", "heading", "paragraph"
                    ]
                },
                "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "label": { "type": "string", "minLength": 1, "maxLength": 255 },
                "placeholder": { "type": ["string", "null"], "maxLength": 255 },
                "help": { "type": ["string", "null"], "maxLength": 1000 },
                "default": {
                    "type": ["string", "number", "boolean", "array", "null"]
                },
                "required": { "type": "boolean", "default": false },
                "options": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                        "type": "object",
                        "required": ["label", "value"],
                        "additionalProperties": false,
                        "properties": {
                            "label": { "type": "string", "minLength": 1, "maxLength": 255 },
                            "value": { "type": ["string", "number"], "maxLength": 255 }
                        }
                    }
                },
                "validation": { "$ref": "#/$defs/validation" },
                "conditions": { "$ref": "#/$defs/conditions" }
            }
        },
        "validation": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "min": { "type": ["number", "null"] },
                "max": { "type": ["number", "null"] },
                "minLength": { "type": ["integer", "null"], "minimum": 0 },
                "maxLength": { "type": ["integer", "null"], "minimum": 1 },
                "pattern": { "type": ["string", "null"], "maxLength": 500 },
                "url": { "type": ["boolean", "null"] },
                "integer": { "type": ["boolean", "null"] },
                "mimes": {
                    "type": ["array", "null"],
                    "items": { "type": "string", "pattern": "^[a-z0-9]{1,10}$" },
                    "maxItems": 20
                },
                "maxSizeKb": { "type": ["integer", "null"], "minimum": 1, "maximum": 51200 },
                "minDate": { "type": ["string", "null"], "format": "date" },
                "maxDate": { "type": ["string", "null"], "format": "date" }
            }
        },
        "conditions": {
            "type": ["object", "null"],
            "required": ["logic", "rules"],
            "additionalProperties": false,
            "properties": {
                "logic": { "enum": ["all", "any"] },
                "rules": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                        "type": "object",
                        "required": ["field", "operator"],
                        "additionalProperties": false,
                        "properties": {
                            "field": { "type": "string" },
                            "operator": {
                                "enum": [
                                    "equals", "not_equals", "contains",
                                    "greater_than", "less_than",
                                    "is_empty", "is_not_empty"
                                ]
                            },
                            "value": { "type": ["string", "number", "boolean", "null"] }
                        }
                    }
                }
            }
        },
        "elementId": {
            "type": "string",
            "pattern": "^[a-z]+_[a-zA-Z0-9]{4,20}$"
        }
    }
}
